from functools import reduce

# 1. for loop
total = 0
for i in range(1, 11):
    total += i
print("for loop =", total)

# 2. recursion
def sum_num(n):
    if n == 1:
        return 1
    return n + sum_num(n - 1)

print("recursion =", sum_num(10))

# 3. reduce
result = reduce(lambda x, y: x + y, range(1, 11))
print("reduce =", result)
